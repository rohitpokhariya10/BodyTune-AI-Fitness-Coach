# Runtime
NODE_ENV=development
PORT=9000
TRUST_PROXY=false
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
API_DOCS_ENABLED=true

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bodytune
MONGODB_CONNECT_MAX_ATTEMPTS=5
MONGODB_CONNECT_RETRY_DELAY_MS=2000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10

# Browser and API security
CORS_ORIGINS=http://localhost:5173
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Sessions (required when authentication is enabled)
SESSION_SECRET=replace-with-at-least-64-random-characters
SESSION_COOKIE_NAME=bodytune.sid
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth (required when Google authentication is enabled)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Local identity recovery (required only if local authentication remains enabled)
OTP_PEPPER=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private media (production must use an approved private storage provider)
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=./var/media
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNED_URL_TTL_SECONDS=300

# Payments remain disabled until a provider and verified webhook flow are implemented
PAYMENT_PROVIDER=disabled
